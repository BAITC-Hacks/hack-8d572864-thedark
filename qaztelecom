import streamlit as st
import fitz
from docx import Document
from openpyxl import load_workbook
import tempfile
import os

st.set_page_config(
    page_title="OrgMind AI",
    page_icon="🤖",
    layout="wide"
)

st.title("🤖 OrgMind AI")
st.write("Ұйымдық құрылым мен функцияларды талдайтын ЖИ-агент")

# -----------------------------
# ФАЙЛДЫ ОҚУ
# -----------------------------

def read_pdf(file):
    text = ""

    with tempfile.NamedTemporaryFile(delete=False, suffix=".pdf") as tmp:
        tmp.write(file.getvalue())
        path = tmp.name

    document = fitz.open(path)

    for page_number, page in enumerate(document):
        page_text = page.get_text()

        text += f"\n\n--- {page_number + 1}-бет ---\n"
        text += page_text

    document.close()
    os.remove(path)

    return text


def read_docx(file):
    document = Document(file)

    text = ""

    for i, paragraph in enumerate(document.paragraphs):
        if paragraph.text.strip():
            text += f"\n{i + 1}-абзац: {paragraph.text}"

    return text


def read_excel(file):
    workbook = load_workbook(file, data_only=True)

    text = ""

    for sheet in workbook.worksheets:

        text += f"\n\nПарақ: {sheet.title}\n"

        for row_number, row in enumerate(sheet.iter_rows(values_only=True), start=1):

            values = []

            for value in row:
                if value is not None:
                    values.append(str(value))

            if values:
                text += f"{row_number}-жол: {' | '.join(values)}\n"

    return text


def read_file(file):

    extension = file.name.split(".")[-1].lower()

    if extension == "pdf":
        return read_pdf(file)

    elif extension == "docx":
        return read_docx(file)

    elif extension == "xlsx":
        return read_excel(file)

    else:
        return "Бұл файл форматы қолдау көрсетпейді."


# -----------------------------
# ИНТЕРФЕЙС
# -----------------------------

st.subheader("1. Өзгеріске дейінгі құжаттар")

before_files = st.file_uploader(
    "BEFORE құжаттарын жүктеңіз",
    type=["pdf", "docx", "xlsx"],
    accept_multiple_files=True,
    key="before"
)


st.subheader("2. Өзгерістен кейінгі құжаттар")

after_files = st.file_uploader(
    "AFTER құжаттарын жүктеңіз",
    type=["pdf", "docx", "xlsx"],
    accept_multiple_files=True,
    key="after"
)


if st.button("🔍 Құжаттарды талдау"):

    if not before_files or not after_files:

        st.warning("Before және After құжаттарын жүктеңіз.")

    else:

        st.success("Құжаттар сәтті оқылды!")

        st.header("📄 BEFORE")

        for file in before_files:

            st.subheader(file.name)

            try:
                text = read_file(file)

                with st.expander("Құжат мәтінін көру"):
                    st.text(text)

            except Exception as e:
                st.error(f"Қате: {e}")


        st.header("📄 AFTER")

        for file in after_files:

            st.subheader(file.name)

            try:
                text = read_file(file)

                with st.expander("Құжат мәтінін көру"):
                    st.text(text)

            except Exception as e:
                st.error(f"Қате: {e}")