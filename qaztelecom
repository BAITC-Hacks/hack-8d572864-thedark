import json
from anthropic import Anthropic

client = Anthropic()
MODEL = "claude-sonnet-4-5"

COMPARE_PROMPT = """Сен ұйымдық құрылымды реформаға ДЕЙІН және КЕЙІН салыстырасың.

ДЕЙІНГІ бөлімдер мен қызметтер (JSON):
{before}

КЕЙІНГІ бөлімдер мен қызметтер (JSON):
{after}

Тапсырма:
1. Әр "дейінгі" бөлімді "кейінгі" бөліммен(дермен) сәйкестендір. Мысалы, бір лауазым/бөлім
   екі немесе одан көп жаңа бөлімге бөлінуі мүмкін (split) — мұны міндетті түрде тап.
   Статустар: "retained" (сақталды), "renamed" (аты өзгерді), "merged" (қосылды),
   "split" (бөлінді), "removed" (жойылды), "new" (жаңа құрылды).
2. Сәйкестендірілген бөлімдер үшін ДЕЙІН болған, бірақ КЕЙІН жоқ функцияларды тап
   (жоғалған функциялар).
3. Барлық КЕЙІНГІ бөлімдер арасынан бір функцияның екі немесе одан көп бөлімде
   қайталанатынын тап (дублирование).
4. Мүдделер қақтығысын тап: бір бөлім бақылау функциясы мен сол бақылайтын
   орындау функциясын қатар атқарса, немесе жауапкершілік аймақтары анық
   бөлінбесе — соны белгіле.
5. Әр қорытынды МІНДЕТТІ ТҮРДЕ chunk_id(лар)ға сілтеме жасауы керек. Chunk_id-ды
   ойдан шығармау керек, тек берілгендерді ғана қолдану керек.

ТЕК валидті JSON қайтар, markdown белгілерсіз, мына схема бойынша:
{{
  "department_status": [
    {{"before_name": "string|null", "after_name": "string|null", "status": "retained|renamed|merged|split|removed|new", "notes": "string"}}
  ],
  "lost_functions": [
    {{"department": "string", "function": "string", "before_chunk_id": "string", "explanation": "string"}}
  ],
  "duplications": [
    {{"function": "string", "departments": ["string"], "chunk_ids": ["string"], "explanation": "string"}}
  ],
  "conflicts_of_interest": [
    {{"department": "string", "issue": "string", "chunk_ids": ["string"], "severity": "low|medium|high"}}
  ],
  "summary": "string (қазақша немесе орысша, 3-6 сөйлем, нақты ұсыныстар)"
}}
"""

def compare(before_data: dict, after_data: dict) -> dict:
    prompt = COMPARE_PROMPT.format(
        before=json.dumps(before_data, ensure_ascii=False),
        after=json.dumps(after_data, ensure_ascii=False),
    )
    resp = client.messages.create(
        model=MODEL, max_tokens=8000,
        messages=[{"role": "user", "content": prompt}],
    )
    raw = resp.content[0].text.strip()
    raw = raw.removeprefix("```json").removeprefix("```").removesuffix("```").strip()
    return json.loads(raw)